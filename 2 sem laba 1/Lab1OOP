import doctest


class Car:
    def __init__(self, brand: str, fuel_capacity: float, fuel_level: float):
        """
        Создание и подготовка к работе объекта "Автомобиль"

        :param brand: Марка автомобиля
        :param fuel_capacity: Объем топливного бака
        :param fuel_level: Текущий уровень топлива

        Примеры:
        >>> car = Car("Toyota", 50, 10)  # инициализация экземпляра класса
        """
        if not isinstance(brand, str):
            raise TypeError("Марка автомобиля должна быть строкой")
        if not brand:
            raise ValueError("Марка автомобиля не может быть пустой строкой")
        self.brand = brand

        if not isinstance(fuel_capacity, (int, float)):
            raise TypeError("Объем бака должен быть типа int или float")
        if fuel_capacity <= 0:
            raise ValueError("Объем бака должен быть положительным числом")
        self.fuel_capacity = fuel_capacity

        if not isinstance(fuel_level, (int, float)):
            raise TypeError("Уровень топлива должен быть типа int или float")
        if fuel_level < 0:
            raise ValueError("Уровень топлива не может быть отрицательным")
        if fuel_level > fuel_capacity:
            raise ValueError("Уровень топлива не может превышать объем бака")
        self.fuel_level = fuel_level

    def is_empty_tank(self) -> bool:
        """
        Проверка, пустой ли бак.

        :return: True если бак пуст, иначе False

        Примеры:
        >>> car = Car("Toyota", 50, 0)
        >>> car.is_empty_tank()
        """
        ...

    def refuel(self, fuel: float) -> None:
        """
        Заправка автомобиля.

        :param fuel: Количество добавляемого топлива
        :raise ValueError: Если количество топлива превышает свободное место в баке

        Примеры:
        >>> car = Car("Toyota", 50, 10)
        >>> car.refuel(20)
        """
        if not isinstance(fuel, (int, float)):
            raise TypeError("Количество топлива должно быть типа int или float")
        if fuel <= 0:
            raise ValueError("Количество топлива должно быть положительным числом")
        ...

    def drive(self, fuel_spent: float) -> None:
        """
        Поездка на автомобиле.

        :param fuel_spent: Количество израсходованного топлива
        :raise ValueError: Если топлива недостаточно для поездки

        :return: None

        Примеры:
        >>> car = Car("Toyota", 50, 30)
        >>> car.drive(10)
        """
        if not isinstance(fuel_spent, (int, float)):
            raise TypeError("Расход топлива должен быть типа int или float")
        if fuel_spent <= 0:
            raise ValueError("Расход топлива должен быть положительным числом")
        ...


